//result = Tester.testCompare(id, samples+"/t0002.fst", properties.total(), samples+"/t0002_novector.recMz", null, null,null,console )&& result;
//properties.reset("vector");

// range
properties.setVal("start","50ms");
properties.setVal("end","100ms");
result = Tester.testCompare(id, samples+"/t0003.fst", properties.total(), samples+"/t0003_range.recMz", null, null,doubleValueDueToConverion,console) && result;
properties.reset("start");
properties.reset("end");

// select
properties.setVal("include","scp0001");
properties.setVal("exclude","scp0003");
properties.setVal("empty","false");
result = Tester.testCompare(id, samples+"/t0004.fst", properties.total(), samples+"/t0004_select.recMz", null, null,null,console) && result;
properties.reset("include");
properties.reset("exclude");
properties.reset("empty");

// transform
properties.setVal("delay","10ms");
properties.setVal("dilate","2");
result = Tester.testCompare(id, samples+"/t0005.fst", properties.total(), samples+"/t0005_transform.recMz", null, null,endNotAlligned,console) && result;
properties.reset("delay");
properties.reset("dilate");

// internal
result = Tester.testCompare(id, samples+"/t1001.fst",properties.total(),samples+"/t1001.recMz", null, null,null,console) && result;
result = Tester.testCompare(id, samples+"/t1002.fst",properties.total(),samples+"/t1002.recMz", null, null,null,console) && result;
result = Tester.testCompare(id, samples+"/t1003.fst",properties.total(),samples+"/t1003.recMz", null, null,null,console) && result;

