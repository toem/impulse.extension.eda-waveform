// ============================================================================
// Test File: fst-native-reader-test.jx
// Purpose: Comprehensive testing of FST Native Reader functionality
// Coverage: FST file format parsing, signal extraction, time range filtering,
//           signal selection, temporal transformations, data integrity validation
// ============================================================================

// FST (Fast Signal Trace) Format: Compressed waveform database format used in digital design
// Test Method: Compare FST reader output against reference recordings (.recMl files)
// Validation: Cell-by-cell comparison with configurable exclusion patterns

// Test Parameters:
//   - lazy: Controls lazy loading mode (false = load all data upfront)
//   - start/end: Time range filtering (e.g., "50ms", "100ms")
//   - include/exclude: Signal name pattern filtering
//   - empty: Include/exclude empty signals
//   - delay: Time offset transformation
//   - dilate: Time scaling factor

// ============================================================================
// Section 1: Test Setup and Configuration
// ============================================================================

import java.net.URI;
import de.toem.impulse.api.Cells;
import de.toem.impulse.api.Serializers;

// Samples directory path
var samples = new File(new URI(uri)).getParent().toString()+"/samples/";

// FST Native Reader configuration
var id = "de.toem.impulse.reader.fstn";
var descriptor = Elements.serializers.get(id);
var properties = descriptor.getPropertyModel(null,null);
properties.setVal("lazy","false");

// Known Limitations (signals to exclude from strict comparison):
var doubleValueDueToConverion = ".*::samples";       // Double precision conversion differences
var noZXIn1bitSignals = ".*::samples,.*::count";     // Missing X/Z states in 1-bit signals
var endNotAlligned = ".*::end";                       // End time alignment issues

// ============================================================================
// Section 2: Standard Test Cases - Basic FST File Parsing
// ============================================================================

// Test files t0001-t0030: Validate correct parsing of various FST formats
// Each test compares reader output against pre-recorded reference files
// Some tests require exclusion patterns due to known format limitations

Assert.isTrue(Cells.compare(progress, id, samples+"/t0001.fst",properties.total(),null, samples+"/t0001.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0002.fst",properties.total(),null, samples+"/t0002.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0003.fst",properties.total(),null, samples+"/t0003.recMl", null,null,doubleValueDueToConverion,console ));  // due to double conversion differences
Assert.isTrue(Cells.compare(progress, id, samples+"/t0004.fst",properties.total(),null, samples+"/t0004.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0005.fst",properties.total(),null, samples+"/t0005.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0006.fst",properties.total(),null, samples+"/t0006.recMl", null,null,doubleValueDueToConverion,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0007.fst",properties.total(),null, samples+"/t0007.recMl", null,null,noZXIn1bitSignals,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0008.fst",properties.total(),null, samples+"/t0008.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0009.fst",properties.total(),null, samples+"/t0009.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0010.fst",properties.total(),null, samples+"/t0010.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0011.fst",properties.total(),null, samples+"/t0011.recMl", null,null,noZXIn1bitSignals,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0012.fst",properties.total(),null, samples+"/t0012.recMl", null,null,doubleValueDueToConverion,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0013.fst",properties.total(),null, samples+"/t0013.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0014.fst",properties.total(),null, samples+"/t0014.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0015.fst",properties.total(),null, samples+"/t0015.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0016.fst",properties.total(),null, samples+"/t0016.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0017.fst",properties.total(),null, samples+"/t0017.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0018.fst",properties.total(),null, samples+"/t0018.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0019.fst",properties.total(),null, samples+"/t0019.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0020.fst",properties.total(),null, samples+"/t0020.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0021.fst",properties.total(),null, samples+"/t0021.recMl", null,null,null,console));  // can not create fst
Assert.isTrue(Cells.compare(progress, id, samples+"/t0022.fst",properties.total(),null, samples+"/t0022.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0023.fst",properties.total(),null, samples+"/t0023.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0024.fst",properties.total(),null, samples+"/t0024.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0025.fst",properties.total(),null, samples+"/t0025.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0026.fst",properties.total(),null, samples+"/t0026.recMl", null,null,null,console ));
Assert.isTrue(Cells.compare(progress, id, samples+"/t0027.fst",properties.total(),null, samples+"/t0027.recMl", null,null,null,console ));
