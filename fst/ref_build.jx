// range
properties.setVal("start","50ms");
properties.setVal("end","100ms");
Tester.createReference(id, samples+"/t0003.vcd", properties.total(), rid,samples+"/t0003_range.recMz",null, console);
properties.reset("start");
properties.reset("end");

// include / exclude
properties.setVal("include","scp0001");
properties.setVal("exclude","scp0003");
properties.setVal("empty","false");
Tester.createReference(id, samples+"/t0004.vcd", properties.total(), rid,samples+"/t0004_select.recMz",null,console);
properties.reset("include");
properties.reset("exclude");
properties.reset("empty");


// transform
properties.setVal("delay","10ms");
properties.setVal("dilate","2");
Tester.createReference(id, samples+"/t0005.vcd", properties.total(), rid,samples+"/t0005_transform.recMz",null,console);
properties.reset("delay");
properties.reset("dilate");

