// ============================================================================
// Section 3: Vector Mode Testing (Currently Disabled)
// ============================================================================

// Vector mode: Controls whether multi-bit signals are treated as vectors or individual bits
// Test: t0002_novector.recMl validates non-vector mode output

// vector
//properties.setVal("vector","false");
//result = Tester.testCompare(id, samples+"/t0002.fst", properties.total(), samples+"/t0002_novector.recMl", null, null,null,console )&& result;
//properties.reset("vector");

// ============================================================================
// Section 4: Time Range Filtering
// ============================================================================

// Time range filtering: Extract only signals within specified time window
// Test: Validate correct filtering from 50ms to 100ms
// Note: May have double value conversion differences in sampled data

// range
properties.setVal("start","50ms");
properties.setVal("end","100ms");
Assert.isTrue(Cells.compare(progress, id, samples+"/t0003.fst", properties.total(),null, samples+"/t0003_range.recMl", null,null,doubleValueDueToConverion,console));
properties.reset("start");
properties.reset("end");

// ============================================================================
// Section 5: Signal Selection Filtering
// ============================================================================

// Signal selection: Include/exclude signals based on name patterns
// Test configuration:
//   - include: "scp0001" - only signals matching this pattern
//   - exclude: "scp0003" - exclude signals matching this pattern
//   - empty: false - exclude signals with no data

// select
properties.setVal("include","scp0001");
properties.setVal("exclude","scp0003");
properties.setVal("empty","false");
Assert.isTrue(Cells.compare(progress, id, samples+"/t0004.fst", properties.total(),null, samples+"/t0004_select.recMl", null,null,null,console));
properties.reset("include");
properties.reset("exclude");
properties.reset("empty");

// ============================================================================
// Section 6: Temporal Transformations
// ============================================================================

// Temporal transformations: Modify time axis of signals
// Test configuration:
//   - delay: "10ms" - shift all signals forward in time by 10ms
//   - dilate: "2" - stretch time axis by factor of 2 (signals appear slower)
// Note: End time alignment may differ due to transformation

// transform
properties.setVal("delay","10ms");
properties.setVal("dilate","2");
Assert.isTrue(Cells.compare(progress, id, samples+"/t0005.fst", properties.total(),null, samples+"/t0005_transform.recMl", null,null,endNotAlligned,console));
properties.reset("delay");
properties.reset("dilate");

// ============================================================================
// Section 7: Real-World FST File Validation
// ============================================================================

// Real-world test files: Verify that actual FST files from real designs can be read
// without errors and that the correct number of cells (scopes + signals) are extracted
// Cell count validation ensures complete structure parsing of complex hierarchies

var properties = descriptor.getPropertyModel(null,null);
properties.setVal("lazy","false");

// t1001: Expected 872 cells (scopes and signals)
var cover = Serializers.read(progress, id, samples+"/t1001.fst",properties.total(), console);
var noOfCells = cover != null && cover.getCell() != null ? cover.getCell().getTribe(true).size():-1;
Assert.isTrue(noOfCells == 872,"t1001: noOfCells is " + noOfCells);

// t1002: Expected 1759 cells (scopes and signals)
cover = Serializers.read(progress, id, samples+"/t1002.fst",properties.total(), console);
noOfCells = cover != null && cover.getCell() != null ? cover.getCell().getTribe(true).size():-1;
Assert.isTrue(noOfCells == 1759,"t1002: noOfCells is " + noOfCells);

// t1003: Expected 1759 cells (scopes and signals)
cover = Serializers.read(progress, id, samples+"/t1003.fst",properties.total(), console);
noOfCells = cover != null && cover.getCell() != null ? cover.getCell().getTribe(true).size():-1;
Assert.isTrue(noOfCells == 1759,"t1003: noOfCells is " + noOfCells);

// t1004: Expected 5559 cells (scopes and signals)
cover = Serializers.read(progress, id, samples+"/t1004.fst",properties.total(), console);
noOfCells = cover != null && cover.getCell() != null ? cover.getCell().getTribe(true).size():-1;
Assert.isTrue(noOfCells == 5559,"t1004: noOfCells is " + noOfCells);


