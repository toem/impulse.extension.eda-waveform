var Tester = Class.forName("de.toem.toolkits.pattern.element.serializer.AbstractCellReader");
var id = "de.toem.impulse.reader.fstn";
var samples = pwd+"/samples/";
var descriptor = Elements.serializers.get(id);
var properties = descriptor.getPropertyModel(null,null);
properties.setVal("lazy","false");

// limitation
var doubleValueDueToConverion = ".*::samples";
var noZXIn1bitSignals = ".*::samples,.*::count";
var endNotAlligned = ".*::end";

//  boolean testCompare( id,  fileName, properties,  refName, refProperties,  includes, excludes,  console) 
var result = true;
result = Tester.testCompare(id, samples+"/t0001.fst",properties.total(),samples+"/t0001.recMz", null, null,null,console )&& result;
result = Tester.testCompare(id, samples+"/t0002.fst",properties.total(),samples+"/t0002.recMz", null, null,null,console )&& result;
result = Tester.testCompare(id, samples+"/t0003.fst",properties.total(),samples+"/t0003.recMz", null, null,doubleValueDueToConverion,console )&& result;  // due to double conversion differences
result = Tester.testCompare(id, samples+"/t0004.fst",properties.total(),samples+"/t0004.recMz", null, null,null,console )&& result;
