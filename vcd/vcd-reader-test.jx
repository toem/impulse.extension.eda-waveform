
// ============================================================================
// Test File: vcd-reader-test.jx
// Purpose: Comprehensive testing of VCD Reader functionality
// Coverage: VCD file format parsing, signal extraction, time range filtering,
//           signal selection, temporal transformations, data integrity validation
// ============================================================================

// VCD (Value Change Dump) Format: Standard waveform database format used in digital design
// Test Method: Compare VCD reader output against reference recordings (.recMl files)
// Validation: Cell-by-cell comparison with configurable exclusion patterns

// Test Parameters:
//   - lazy: Controls lazy loading mode (false = load all data upfront)
//   - start/end: Time range filtering (e.g., "1us", "3us")
//   - include/exclude: Signal name pattern filtering
//   - empty: Include/exclude empty signals
//   - delay: Time offset transformation
//   - dilate: Time scaling factor

// ============================================================================
// Section 1: Test Setup and Configuration
// ============================================================================

import java.net.URI;
import de.toem.impulse.api.Cells;
import de.toem.impulse.api.Serializers;

// Samples directory path
var samples = new File(new URI(uri)).getParent().toString()+"/samples/";

// VCD Reader configuration
var id = "de.toem.impulse.reader.vcd";
var descriptor = Elements.serializers.get(id);
var properties = descriptor.getPropertyModel(null,null);

// Known Limitations (signals to exclude from strict comparison):
var endNotAlligned = ".*::end";

// ============================================================================
// Section 2: Standard Test Cases - Basic VCD File Parsing
// ============================================================================

// Test files t0001-t0030: Validate correct parsing of various VCD formats
// Each test compares reader output against pre-recorded reference files
// Some tests require exclusion patterns due to known format limitations

Assert.isTrue(Cells.compare(progress, id, samples+"/t0001.vcd",properties.total(),null, samples+"/t0001.recMl", null,null,null,console ));
