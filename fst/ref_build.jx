var Tester = Class.forName("de.toem.toolkits.pattern.element.serializer.AbstractCellReader");
var samples = pwd+"/samples/";

var id = "de.toem.impulse.reader.vcd";
var descriptor = Elements.serializers.get(id);
var properties = descriptor.getPropertyModel(null,null);
var noVector = descriptor.getPropertyModel(null,null);
noVector.setVal("vector","false");

var rid = "de.toem.serializer.genericZmlWriter";


Tester.createReference(id, samples+"/t0001.vcd",null,rid, null, null, console);
Tester.createReference(id, samples+"/t0002.vcd",null,rid, null, null, console);
Tester.createReference(id, samples+"/t0002.vcd",noVector.total(),rid, samples+"/t0002_novector.recMz", null, console);
