// ============================================================================
// Section 3: Time Range Filtering
// ============================================================================

// Time range filtering: Extract only signals within specified time window
// Test: Validate correct filtering from 1us to 3us
// Note: May have double value conversion differences in sampled data

// range
properties.setVal("start","1us");
properties.setVal("end","3us");
Assert.isTrue(Cells.compare(progress, id, samples+"/t0002.vcd", properties.total(),null, samples+"/t0002_range.recMl", null,null,null,console));
properties.reset("start");
properties.reset("end");

// ============================================================================
// Section 4: Signal Selection Filtering
// ============================================================================

// Signal selection: Include/exclude signals based on name patterns
// Test configuration:
//   - include: "scp0003" - only signals matching this pattern
//   - exclude: "scp0004" - exclude signals matching this pattern
//   - empty: false - exclude signals with no data

// select
properties.setVal("include","scp0003");
properties.setVal("exclude","scp0004");
properties.setVal("empty","false");
Assert.isTrue(Cells.compare(progress, id, samples+"/t0002.vcd", properties.total(),null, samples+"/t0002_select.recMl", null,null,null,console));
properties.reset("include");
properties.reset("exclude");
properties.reset("empty");

// ============================================================================
// Section 5: Vector Mode Testing
// ============================================================================

// Vector mode: Controls whether multi-bit signals are treated as vectors or individual bits
// Test: t0019_novector.recMl validates non-vector mode output

// vector
properties.setVal("vector","false");
//Assert.isTrue(Cells.compare(progress, id, samples+"/t0019.vcd", properties.total(),null, samples+"/t0019_novector.recMl", null,null,null,console));
properties.reset("vector");

// ============================================================================
// Section 6: Temporal Transformations
// ============================================================================

// Temporal transformations: Modify time axis of signals
// Test configuration:
//   - delay: "10ms" - shift all signals forward in time by 10ms
//   - dilate: "2" - stretch time axis by factor of 2 (signals appear slower)
// Note: End time alignment may differ due to transformation

// transform
properties.setVal("delay","10ms");
properties.setVal("dilate","2");
//Assert.isTrue(Cells.compare(progress, id, samples+"/t0019.vcd", properties.total(),null, samples+"/t0019_transform.recMl", null,null,endNotAlligned,console));
properties.reset("delay");
properties.reset("dilate");